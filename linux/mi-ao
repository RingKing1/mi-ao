        ;;
    *)
        echo "米遥 (MI-AO) Linux 管理命令行"
        echo "用法: $0 {start|stop|restart|status|enable|disable|logs|shortcuts|test}"
        echo ""
        echo "  start      - 在后台启动米遥服务"
        echo "  stop       - 停止后台服务"
        echo "  restart    - 重启后台服务"
        echo "  status     - 查看遥控器连接与服务运行状态"
        echo "  enable     - 设置开机自动在后台启动"
        echo "  disable    - 取消开机自启"
        echo "  logs       - 实时查看语音输入与识别日志"
        echo "  shortcuts  - 查看遥控器按键全景速查表"
        echo "  test       - 在前台直接运行测试"
        exit 1
        ;;
esac
